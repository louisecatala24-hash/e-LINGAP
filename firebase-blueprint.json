{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "middleName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "sex": {
          "type": "string",
          "enum": [
            "Male",
            "Female",
            "Other"
          ]
        },
        "civilStatus": {
          "type": "string",
          "enum": [
            "Single",
            "Married",
            "Separated"
          ]
        },
        "birthYear": {
          "type": "string"
        },
        "birthMonth": {
          "type": "string"
        },
        "birthDay": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "solo-parent",
            "senior",
            "pwd"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "username",
        "birthYear",
        "birthMonth",
        "birthDay",
        "mobile",
        "email"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "DSWD benefit application and appointment details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "benefitTitle": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending Verification",
            "Confirmed",
            "Rescheduled"
          ]
        },
        "location": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "benefitTitle",
        "date",
        "status",
        "location",
        "createdAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for appointment updates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "appointment_approval",
            "general"
          ]
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "message",
        "isRead",
        "createdAt"
      ]
    },
    "News": {
      "title": "News",
      "description": "App news and announcements",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "day": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "content",
        "date",
        "createdAt"
      ]
    },
    "SystemUpdate": {
      "title": "SystemUpdate",
      "description": "Real-time system announcement from admin",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "day": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "message",
        "date",
        "updatedAt"
      ]
    },
    "Benefit": {
      "title": "Benefit",
      "description": "Government benefit program details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "solo-parent",
            "senior",
            "pwd"
          ]
        },
        "titleEn": {
          "type": "string"
        },
        "titleFil": {
          "type": "string"
        },
        "descEn": {
          "type": "string"
        },
        "descFil": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "freqEn": {
          "type": "string"
        },
        "freqFil": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "category",
        "titleEn",
        "titleFil",
        "descEn",
        "descFil",
        "amount",
        "icon",
        "color"
      ]
    },
    "BenefitRequirements": {
      "title": "BenefitRequirements",
      "description": "Requirements for a specific benefit category",
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "solo-parent",
            "senior",
            "pwd"
          ]
        },
        "requirementsEn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirementsFil": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "category",
        "requirementsEn",
        "requirementsFil"
      ]
    },
    "SupportMessage": {
