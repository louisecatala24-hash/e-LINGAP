          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "titleEn",
        "titleFil",
        "landline",
        "globe",
        "smart",
        "email"
      ]
    },
    "DswdContact": {
      "title": "DswdContact",
      "description": "DSWD Contact Us card details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "Image": {
      "title": "Image",
      "description": "DSWD related portal images and assets metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uploadedBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "url"
      ]
    }
  },
  "firestore": {
    "images/{imageId}": {
      "schema": "Image",
      "description": "Stored official imagery and portals logos dataset"
    },
    "DSWD CONTACTS/{contactId}": {
      "schema": "DswdContact",
      "description": "Contact Us information per category"
    },
    "system/contacts": {
      "schema": "SystemContacts",
      "description": "DSWD Contact details configured by admins"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles by UID"
    },
    "appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Benefit appointments tracking"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "News for users/{newsId}": {
      "schema": "News",
      "description": "App announcements"
    },
    "system/{configId}": {
      "schema": "SystemUpdate",
      "description": "Global system updates and announcements"
    },
    "services/{serviceId}": {
      "schema": "Benefit",
      "description": "Service programs"
    },
    "benefit-requirements/{categoryId}": {
      "schema": "BenefitRequirements",
      "description": "Requirements list per category"
    },
    "messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Welfare support chat sessions and history messages"
    }
  }
}
