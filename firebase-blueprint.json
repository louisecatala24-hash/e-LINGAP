        },
        "sender_id": {
          "type": "string"
        },
        "sender_name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "is_bot": {
          "type": "boolean"
        }
      },
      "required": [
        "sender_id",
        "sender_name",
        "message",
        "is_bot"
      ]
    },
